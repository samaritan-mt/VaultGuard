<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox: hdiutil requires IOKit/XPC device access that the sandbox blocks.
	     VaultGuard is distributed outside the App Store so sandbox is not required. -->

	<!-- Keychain access group shared with Finder extension -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.vaultguard</string>
	</array>
	<!-- App Group for file-based IPC and shared UserDefaults with Finder extension -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.vaultguard.shared</string>
	</array>
</dict>
</plist>
